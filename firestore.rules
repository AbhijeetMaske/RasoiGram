rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---
    function isValidUser(data) {
      return data.email is string && data.email.size() < 100
          && (data.displayName == null || (data.displayName is string && data.displayName.size() < 100));
    }

    function isValidIngredient(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 100
          && data.category is string && data.category.size() <= 50
          && data.addedAt == request.time;
    }

    function isValidRecipe(data) {
      return data.title is string && data.title.size() <= 200
          && data.cuisine is string
          && data.generatedAt == request.time;
    }

    // --- Collections ---

    // Users & Profiles
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) 
                     && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'preferences']);

      // Inventory
      match /inventory/{ingredientId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(ingredientId);
        allow create: if isOwner(userId) && isValidIngredient(incoming());
        allow delete: if isOwner(userId);
        allow update: if isOwner(userId) && isValidIngredient(incoming())
                       && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'category', 'quantity', 'expiryDate']);
      }

      // History
      match /history/{recipeId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(recipeId);
        allow create: if isOwner(userId) && isValidRecipe(incoming());
        allow delete: if isOwner(userId);
      }
    }
  }
}
